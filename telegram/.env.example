# 从 https://my.telegram.org 获取
TG_API_ID=123456
TG_API_HASH=替换为你的_api_hash

# 每个 bot 可配置 command 和 timeout（秒）
TG_BOTS='[
  {"bot": "@example_a_bot", "command": "/checkin", "timeout": 30},
  {"bot": "@example_b_bot", "command": "签到", "timeout": 30}
]'

# 相对路径以脚本目录为基准；青龙建议使用 /ql/data/tg-checkin/account.session
TG_SESSION_FILE=.data/account.session

# 收到回复后，连续多少秒没有新回复或内容更新就结束收集
TG_REPLY_WAIT=3

# 按需配置，支持 socks5、http；用户名和密码中的特殊字符需 URL 编码
# TG_PROXY=socks5://127.0.0.1:1080
# TG_PROXY=http://user:password@proxy.example.com:8080
